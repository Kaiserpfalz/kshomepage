{
  "name": "kswebsite",
  "version": "1.0.0",
  "description": "dev tooling for kaiserpfalz-aachen.de",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:tw": "npx @tailwindcss/cli -i themes/KSThemeV1/main.css -o themes/KSThemeV1/assets/css/tailwind.css",
    "build:hugo": "hugo",
    "build": "npm run build:tw && npm run build:hugo",
    "dev:tw": "npx @tailwindcss/cli -i themes/KSThemeV1/main.css -o themes/KSThemeV1/assets/css/tailwind.css -w",
    "dev:hugo": "hugo server --bind 0.0.0.0",
    "dev": "concurrently 'npm run dev:tw' 'npm run dev:hugo'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.0.0"
  }
}
